# Resume2Interview AI - Environment Configuration Example
# Copy this file to .env and customize the values for your local environment.

# Application Security
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for local development, PostgreSQL compatible)
DATABASE_URL=sqlite:///./resume2interview.db

# Server & CORS
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=127.0.0.1

# File Upload Constraints
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# AI Provider Configuration (Optional: system automatically uses rich offline heuristic/question-bank fallback if empty)
# Set GEMINI_API_KEY or OPENAI_API_KEY to enable live LLM evaluation & question generation.
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
